#!/bin/sh
# /quiz に合格していないコミットは push させない。
# この clone からの通常の push を検査する。GitHub 上の操作や --no-verify は防げない。
#
# 有効化（clone ごとに 1 回）:
#   git config core.hooksPath .agents/githooks
#
git_dir=$(git rev-parse --git-dir) || exit 1
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # ブランチの削除は素通し
  [ "$local_sha" = "$zero" ] && continue
  # タグなどブランチ以外は素通し
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  # 合格記録は送信元ブランチに属する。別名で push しても同じ記録を使う。
  case "$local_ref" in
    refs/heads/*) branch=${local_ref#refs/heads/} ;;
    *) branch=$(git symbolic-ref --quiet --short HEAD) || exit 1 ;;
  esac

  marker="$git_dir/quiz-pass/$(printf '%s' "$branch" | tr '/' '_')"
  passed=''
  score=''
  if [ -f "$marker" ]; then
    line=$(head -n 1 "$marker")
    passed=$(printf '%s' "$line" | awk '{ print $1 }')
    # 日時にスペースを含む書き方でも読めるよう、点数は後ろから 2 番目の欄を見る
    score=$(printf '%s' "$line" | awk 'NF >= 4 { print $(NF - 1) }')
  fi

  # クイズは 4 択 3 問固定。2 問以上で合格
  if [ "$passed" = "$local_sha" ] && printf '%s\n' "$score" | awk -F/ '
    /^[0-3]\/3$/ && $1 >= 2 { ok=1 }
    END { exit !ok }
  '; then
    continue
  fi

  echo "" >&2
  echo "  push を中止しました: $branch" >&2
  if [ -z "$passed" ]; then
    echo "  このブランチはまだ /quiz に合格していません。" >&2
    echo "  Claude Code なら /quiz、Codex なら \$quiz を実行してください。" >&2
  elif [ "$passed" != "$local_sha" ]; then
    echo "  /quiz に合格したのは $(printf '%s' "$passed" | cut -c1-7) ですが、push しようとしているのは $(printf '%s' "$local_sha" | cut -c1-7) です。" >&2
    echo "  コミットが変わっているので、clone したディレクトリから /quiz を受け直してください。" >&2
  else
    echo "  記録の点数が有効ではありません（$score）。3 問中 2 問以上の合格が必要です。" >&2
    echo "  clone したディレクトリから /quiz を受け直してください。" >&2
  fi
  echo "" >&2
  echo "  ブランチ名による免除はありません。本人がクイズに回答してください。" >&2
  echo "" >&2
  status=1
done

exit $status
